rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shpetxst@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'shpetxst@gmail.com') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin')
      );
    }

    // Default global rule: read public, write admin shpetxst@gmail.com
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Explicit storage paths for announcements, mentorshpe, uploads, site assets, officers
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /mentorshpe/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mentorshpe_gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /site_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /officer_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsor_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
